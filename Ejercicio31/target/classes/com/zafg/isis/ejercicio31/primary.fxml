<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml/1" alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/8.0.171" fx:controller="com.zafg.isis.ejercicio31.PrimaryController">
    <children>
        <Label text="Contar número de clics" />
        <TextField fx:id="txtClics" text="0" />
        <Button text="¡Contar!" onAction="#contar" />

        <Label text="Esperar 10 segundos" />
        <ProgressBar fx:id="pbEspera" prefWidth="300.0" progress="0.0" />
        <Button fx:id="btnEspera" text="¡Esperar!" onAction="#esperar" />
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>