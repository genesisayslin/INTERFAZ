<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml/1" alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/8.0.171" fx:controller="com.zafg.isis.ejercicio32.PrimaryController">
    <children>
        <Label text="La Liebre y la Tortuga" />
        <Button fx:id="btnIniciar" text="¡Iniciar Carrera!" onAction="#iniciar" />
        
        <Label fx:id="lblLiebre" text="La Liebre:" />
        <ProgressBar fx:id="pbLiebre" prefWidth="300.0" progress="0.0" />

        <Label fx:id="lblTortuga" text="La Tortuga:" />
        <ProgressBar fx:id="pbTortuga" prefWidth="300.0" progress="0.0" />
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>
